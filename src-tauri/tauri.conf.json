{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Afterwork",
  "version": "0.8.0",
  "identifier": "app.afterwork.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Afterwork", "width": 1248, "height": 860, "minWidth": 1248, "minHeight": 818, "visible": false, "decorations": false, "backgroundColor": "#0e0f15" }],
    "security": { "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "nsis": { "languages": ["Russian"], "installerHooks": "nsis/hooks.nsh" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "endpoints": ["https://github.com/Linsaym/Afterwork/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
